# ============================================================
# .env.prod.example — Template de variables de entorno
#                     para el entorno de PRODUCCIÓN
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.prod.example .env.prod
#   2. Rellena TODOS los valores marcados con <CAMBIAR>
#   3. NUNCA subas .env.prod al repositorio (está en .gitignore)
# ============================================================

# ── Aplicación ────────────────────────────────────────────────
APP_NAME="Aula Virtual"
APP_ENV=production
# Genera con: php artisan key:generate --show
APP_KEY=base64:<CAMBIAR>
APP_DEBUG=false
# URL pública del servidor (sin trailing slash)
APP_URL=https://tudominio.com
APP_TIMEZONE=America/Lima

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_CONNECTION=pgsql
# Nombre del servicio Docker (NO cambiar si usas docker-compose.prod.yml)
DB_HOST=database
DB_PORT=5432
DB_DATABASE=aula_virtual
DB_USERNAME=<CAMBIAR>
# Contraseña fuerte: mínimo 20 chars, alfanumérico + símbolos
DB_PASSWORD=<CAMBIAR>

# Variables usadas por el contenedor postgres directamente
POSTGRES_USER=<CAMBIAR>          # Debe coincidir con DB_USERNAME
POSTGRES_PASSWORD=<CAMBIAR>      # Debe coincidir con DB_PASSWORD
POSTGRES_DB=aula_virtual

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Activa autenticación en Redis (recomendado en producción)
REDIS_PASSWORD=<CAMBIAR>

# ── Cache / Colas / Sesiones ──────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Tiempo de sesión en minutos (120 = 2 horas)
SESSION_LIFETIME=120

# ── Correo electrónico ────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=<CAMBIAR>              # p.ej. smtp.sendgrid.net, smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=<CAMBIAR>
MAIL_PASSWORD=<CAMBIAR>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="Aula Virtual"

# ── Filesystem ────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Sanctum (dominios de frontend autorizados) ────────────────
# Lista separada por comas; incluir dominio y puerto si aplica
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com

# ── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stack
# Niveles válidos: debug | info | notice | warning | error | critical
LOG_LEVEL=warning
# Rotación de logs: daily mantiene N archivos
LOG_DEPRECATIONS_CHANNEL=null

# ── Contraseñas iniciales de seeder ───────────────────────────
# Solo relevantes si ejecutas db:seed en producción
# Usa contraseñas distintas a las de desarrollo
SUPERADMIN_INITIAL_PASSWORD=<CAMBIAR>
ADMIN_INITIAL_PASSWORD=<CAMBIAR>
COORD_INITIAL_PASSWORD=<CAMBIAR>
DOCENTE_INITIAL_PASSWORD=<CAMBIAR>
ALUMNO_INITIAL_PASSWORD=<CAMBIAR>

# Deshabilitar datos demo en producción
SEED_DEMO_DATA=false

# ── Opcionales / Integraciones externas ───────────────────────
# AWS S3 (si usas disk s3 para almacenamiento)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# Sentry (monitoreo de errores)
# SENTRY_LARAVEL_DSN=https://<key>@o0.ingest.sentry.io/<project>

# ── Configuración interna de Docker Compose ───────────────────
# (usadas por docker-compose.prod.yml para el healthcheck de Redis)
# No son variables de Laravel; son leídas por el shell de compose
